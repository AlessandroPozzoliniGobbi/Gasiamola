# Copy this file to frontend/.env.local (do not commit that file).
# MapTiler public browser key. Allow localhost, 127.0.0.1 and your Vercel domain in MapTiler Cloud.
NEXT_PUBLIC_MAPTILER_KEY=YOUR_MAPTILER_KEY
# Integration worktree: backend 8001, frontend 3001; showcase typically uses 8000/3000.
NEXT_PUBLIC_FIELDWISE_API_URL=http://127.0.0.1:8001
